<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/txtTipoAtualVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo (Atual: MÉDIA)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- RadioGroup agrupa as opções para que apenas uma possa ser selecionada -->
    <RadioGroup
        android:id="@+id/radioGroupVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioBaixo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Baixo"/>

        <RadioButton
            android:id="@+id/radioMedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Médio"/>

        <RadioButton
            android:id="@+id/radioAlto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alto"/>
    </RadioGroup>
</LinearLayout>