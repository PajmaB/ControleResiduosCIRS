<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Encerrar Agendamento"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtNomeEmpresaDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Empresa: Carregando..."
        android:textSize="20sp"
        android:textAlignment="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnConcluido"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Carregamento Concluído\n(Zerar estoque e salvar histórico)"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnNaoConcluido"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="Não Concluído\n(Apenas apagar agendamento)"
        android:backgroundTint="#F44336"/>

</LinearLayout>