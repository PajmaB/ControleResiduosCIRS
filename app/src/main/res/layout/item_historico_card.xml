<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#FFFFFF" android:elevation="2dp" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:orientation="horizontal">

        <TextView android:id="@+id/txtDataLog" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:layout_width="wrap_content" android:text="01/10/2023" android:textColor="#1565C0" android:textSize="16sp" android:textStyle="bold"/>

        <TextView android:id="@+id/txtEmpresaLog" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Empresa de Retirada" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Resíduos Carregados:" android:textColor="#757575" android:textSize="12sp"/>

    <TextView android:id="@+id/txtResiduosLog" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:text="Papelão (Fardo), Plástico (Tambor)" android:textColor="#333333" android:textSize="14sp"/>

    <TextView android:id="@+id/txtResponsavelLog" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Concluído por: João da Silva" android:textAlignment="viewEnd" android:textColor="#4CAF50" android:textSize="12sp"/>
</LinearLayout>